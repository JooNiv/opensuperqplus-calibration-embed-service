# Base URL of the FiQCI backend that serves VTT Q50 calibration data.
# CORS is open on this host, so the browser fetches it directly.
PUBLIC_FIQCI_API=https://fiqci-backend.2.rahtiapp.fi

# Where Tuna-17's data is read from. The default points at the placeholder
# snapshot bundled in public/data/tuna17/ (static.json + calibration.json).
# Point this at the real Delft API once it is available. Nothing else changes,
# provided it serves the same two documents.
PUBLIC_TUNA17_BASE=/data/tuna17
