# Base URL of the FiQCI backend that serves VTT Q50 calibration data.
# CORS is open on this host, so the browser fetches it directly.
PUBLIC_FIQCI_API=https://fiqci-backend.2.rahtiapp.fi

# Quantum Inspire (Delft Tuna devices). Static device data comes from the main
# API's public /backend_types/ list, calibration from the Backend Metrics API.
PUBLIC_QI_API=https://api.quantuminspire.com
PUBLIC_QI_METRICS_API=https://metrics.quantuminspire.com
